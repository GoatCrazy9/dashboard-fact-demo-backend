# Copia este archivo como .env en la raíz del backend y completa los valores reales.

# Neon: usa la cadena *pooled* y termina en ?sslmode=require
DATABASE_URL="postgresql://usuario:clave@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

PORT=3001

# Proveedor SUNAT: auto | local | apisperu | direct
# auto = apisperu si tiene credenciales, luego direct, luego local (comportamiento histórico)
SUNAT_PROVEEDOR=auto

# beta | produccion | local
# "local" fuerza el simulador cuando SUNAT_PROVEEDOR=auto
SUNAT_MODO=beta

# APIsPERU (se mantiene como alternativa)
APISPERU_BASE_URL="https://api.apisperu.pro"
APISPERU_CLIENT_ID=""
APISPERU_CLIENT_SECRET=""
APISPERU_RUC=""

# ---- SUNAT directo (UBL 2.1 + XAdES-BES + SOAP sendBill) ----
# Usuario SOL: normalmente RUC + usuario SOL; la contraseña es la de SOL.
SUNAT_RUC=""
SUNAT_SOL_USUARIO=""
SUNAT_SOL_PASSWORD=""

# Certificado: opción A, PKCS#12 (.pfx) por ruta o contenido base64.
SUNAT_CERTIFICATE_PFX_PATH=""
SUNAT_CERTIFICATE_PFX_PASSWORD=""
SUNAT_CERTIFICATE_PFX_BASE64=""

# Certificado: opción B, X.509 + llave privada PEM por ruta...
SUNAT_CERTIFICATE_PEM_PATH=""
SUNAT_PRIVATE_KEY_PEM_PATH=""
# ...o por contenido (PEM literal con \n, o base64 del PEM).
SUNAT_CERTIFICATE_PEM=""
SUNAT_PRIVATE_KEY_PEM=""
SUNAT_CERTIFICATE_PEM_BASE64=""
SUNAT_PRIVATE_KEY_PEM_BASE64=""

# Endpoints y timeout (opcionales; por defecto beta y producción de SUNAT)
SUNAT_ENDPOINT_BETA="https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService"
SUNAT_ENDPOINT_PRODUCCION="https://e-factura.sunat.gob.pe/ol-ti-itcpfegem/billService"
SUNAT_TIMEOUT_MS=30000

# ---- Consulta RENIEC / RUC (mismas variables que el backend de demo) ----
# Proveedor Factiliza: https://docs.factiliza.com/api-consulta
# Si falta alguna, /api/reniec/* responde 503 "RENIEC_NO_CONFIGURADO".
URL_RENIEC=""
TOKEN_CONSULTA_RENIEC=""
TIMEOUT_RENIEC_MS=30000

# ---- Autenticación ----
# Genera valores distintos, por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# AUTH_JWT_SECRET debe tener al menos 32 caracteres. Rotarlo invalida los tokens vigentes.
AUTH_JWT_SECRET=""
AUTH_PASSWORD_PEPPER=""
AUTH_TTL_SECONDS=28800
AUTH_MAX_INTENTOS=5
AUTH_BLOQUEO_MINUTOS=5
AUTH_VENTANA_MINUTOS=15

# Usuarios iniciales creados por db:seed (solo si no existen)
# Define las contraseñas solo en tu .env local; nunca las versiones.
ADMIN_USUARIO="admin"
ADMIN_CONTRASENA=""
MAESTRO_USUARIO="maestro"
MAESTRO_CONTRASENA=""
