    "node-forge": "^1.4.4",
    "prisma": "6.19.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "xml-crypto": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/node-forge": "^1.3.11",
